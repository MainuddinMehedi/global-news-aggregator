# Database
# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://user:pass@host:6543/db?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://user:pass@host:5432/db"

# ==========================================
# AI — PROVIDERS
# Set credentials once per provider.
# The code reads these directly.
# ==========================================

# Groq — ingestion pipeline, fast UI utilities, chat
# Free tier: 30K TPM (Scout), 12K TPM (70B), 8K TPM (GPT OSS 20B)
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google AI Studio — large-context summarization + refinement fallback
# Free tier: Unlimited TPM (Gemma 4), 250K TPM (Flash Lite)
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# GitHub Models — interactive AI chat only (Grok, DeepSeek, GPT-4o)
# Constraint: 8K input token cap + 50 RPD. Do NOT use for ingestion.
GITHUB_MODELS_API_KEY=your-github-pat
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# Mistral — ingestion pipeline primary provider, chat backup
# Free tier: 2.25M TPM (Small), 625K TPM (8B)
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# OpenRouter — last-resort fallback (optional, deprioritized: 50 req/day)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==========================================
# AI — MODEL SLOTS (by use-case)
# Only model names here. Credentials and base URLs
# come from the provider vars above.
# Provider used by each slot is noted in comments.
# See docs/AI_MODELS.md for full rationale.
# ==========================================

# --- Ingestion Pipeline (Enrichment & Clustering) ---
# Primary: Mistral Small (2.25M TPM limit)
AI_INGESTION_MODEL=mistral-small-2506

# Fallback: Llama 4 Scout (30K TPM limit)
AI_INGESTION_FALLBACK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- User-Facing: Fast UI Interactions ---

# Topic refinement modal (Step 3) — ~1K t/s, sub-second latency
# Provider: Groq
AI_UTILITY_MODEL=openai/gpt-oss-20b

# Gemini fallback — shared fallback for both UI refinement and summarization
AI_GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Large-Context: Bulk Summarization ---

# On-demand summaries (50–200 articles, ~20K–40K tokens) — Unlimited TPM on Gemma 4
# Fallback: AI_GEMINI_FALLBACK_MODEL
AI_SUMMARY_MODEL=gemma-4-31b

# --- Topic Findings Overview ---

# AI-generated situational overview of topic findings
# Provider: Google AI Studio (separate from Groq to avoid rate collisions)
# Only triggers when a topic has >= AI_OVERVIEW_THRESHOLD findings
AI_OVERVIEW_MODEL=gemma-4-31b
AI_OVERVIEW_THRESHOLD=10

# ==========================================
# Rate Limiting & Performance
# ==========================================
# Tune to Groq Free Tier (Scout: 30K TPM, 30 RPM)
AI_TPM_LIMIT=25000          # Safety margin below 30K
AI_RPM_LIMIT=28
AI_TOKEN_MULTIPLIER=1.4     # cl100k_base to Llama tokenizer compensation

# Processing Config
AI_BATCH_SIZE=5
AI_CONCURRENCY_LIMIT=1      # Must be 1 for sliding-window rate limiting
AI_TIMEOUT_MS=60000         # Higher timeout for 70B fallback
AI_RETRY_ATTEMPTS=2
AI_RESERVED_CLUSTERING_OUTPUT_TOKENS=1500  # Clustering output budget (assignments + updates + new clusters)

# Cluster Lifespan Configuration (Days inactive before closure)
CLUSTER_STABLE_INACTIVE_DAYS=7
CLUSTER_LOW_IMPACT_INACTIVE_DAYS=10
CLUSTER_MEDIUM_IMPACT_INACTIVE_DAYS=21
CLUSTER_HIGH_IMPACT_INACTIVE_DAYS=35
CLUSTER_CRITICAL_IMPACT_INACTIVE_DAYS=60

# ==========================================
# Other Config
# ==========================================

# Search APIs (Optional - for Chat Search Grounding)
BRAVE_API_KEY=your-key
GOOGLE_CSE_ID=your-id
GOOGLE_API_KEY=your-key

# Notifications
TELEGRAM_BOT_TOKEN=your-token
TELEGRAM_CHAT_ID=your-chat-id
DISCORD_WEBHOOK_URL=your-webhook-url

# App & Authentication
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
REVALIDATE_SECRET=your-secure-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email / Nodemailer SMTP Login
# Use smtps:// protocol for SSL on port 465, or smtp:// for STARTTLS on port 587
EMAIL_SERVER=smtps://username:password@smtp.example.com:465
EMAIL_FROM=no-reply@example.com

