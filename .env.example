# Database
# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://user:pass@host:6543/db?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://user:pass@host:5432/db"

# ==========================================
# AI STRATEGY (Multi-Provider)
# See docs/AI_MODELS.md for details
# ==========================================

# 1. Ingestion Pipeline — Enrichment & Clustering (Groq)
AI_PRIMARY_PROVIDER=groq
AI_PRIMARY_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
AI_PRIMARY_API_KEY=your-groq-key

# 2. Ingestion Fallback — (Groq 70B is required for batch size token limits)
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=llama-3.3-70b-versatile
AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
AI_FALLBACK_API_KEY=your-groq-key

# 3. Topic Management — Refinement & Summaries (Google AI Studio)
# GEMINI_REFINE_MODEL=gemini-3.1-flash-lite (Fast refinement for Step 3 modal - fallback)
# GEMINI_SUMMARY_MODEL=gemma-4-26b (Unlimited TPM for bulk article summarization)
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# 4. Interactive Chat — High Reasoning (GitHub Models)
# Access models like Grok 3, DeepSeek R1, GPT-4o
GITHUB_MODELS_API_KEY=your-github-pat
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# 5. Fast Utilities — Topic Refinement (Groq OSS)
# Used for near-instant UI responses (~1K t/s)
AI_UTILITY_MODEL=openai/gpt-oss-20b
AI_UTILITY_BASE_URL=https://api.groq.com/openai/v1
AI_UTILITY_API_KEY=your-groq-key

# 6. Legacy / Last Resort Fallback (Optional)
AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_OPENROUTER_API_KEY=your-openrouter-key

# ==========================================
# Rate Limiting & Performance
# ==========================================
# Tune to Groq Free Tier (Scout: 30K TPM, 30 RPM)
AI_TPM_LIMIT=28000          # Safety margin below 30K
AI_RPM_LIMIT=28
AI_TOKEN_MULTIPLIER=1.4     # cl100k_base to Llama tokenizer compensation

# Processing Config
AI_BATCH_SIZE=5
AI_CONCURRENCY_LIMIT=1      # Must be 1 for sliding-window rate limiting
AI_TIMEOUT_MS=60000         # Higher timeout for 70B fallback
AI_RETRY_ATTEMPTS=2

# ==========================================
# Other Config
# ==========================================

# Search APIs (Optional - for Chat Search Grounding)
BRAVE_API_KEY=your-key
GOOGLE_CSE_ID=your-id
GOOGLE_API_KEY=your-key

# Notifications
TELEGRAM_BOT_TOKEN=your-token
TELEGRAM_CHAT_ID=your-chat-id
DISCORD_WEBHOOK_URL=your-webhook-url

# App
NEXT_PUBLIC_API_URL=http://localhost:3000/api
REVALIDATE_SECRET=your-secure-secret

# Cluster Lifespan Configuration (Days inactive before closure)
CLUSTER_STABLE_INACTIVE_DAYS=14
CLUSTER_LOW_IMPACT_INACTIVE_DAYS=3
CLUSTER_MEDIUM_IMPACT_INACTIVE_DAYS=5
CLUSTER_HIGH_IMPACT_INACTIVE_DAYS=7
CLUSTER_CRITICAL_IMPACT_INACTIVE_DAYS=30
