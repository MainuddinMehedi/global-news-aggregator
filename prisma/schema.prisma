generator client {
  provider = "prisma-client-js"
  output   = "../shared/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       String             @id @default(uuid())
  name     String             @unique
  articles ProcessedArticle[] @relation("ProcessedArticleCategories")
}

model User {
  id        String      @id @default(uuid())
  email     String?     @unique
  topics    UserTopic[]
  createdAt DateTime    @default(now())
}

model UserTopic {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  topicName      String
  lastNotifiedAt DateTime?
  article        ProcessedArticle? @relation(fields: [articleId], references: [id])
  articleId      String?

  @@unique([userId, topicName])
}

model RawArticle {
  id               String   @id @default(uuid())
  title            String
  contentSnippet   String   @db.Text
  extractedContent String?  @db.Text
  url              String   @unique
  slug             String?  @unique
  source           String
  sourceCountry    String?
  publishedAt      DateTime
  fetchedAt        DateTime @default(now())
  contentHash      String?  @unique
  rawMetadata      Json?

  processedArticle ProcessedArticle?

  @@index([publishedAt])
  @@index([sourceCountry])
}

model ProcessedArticle {
  id                   String     @id @default(uuid())
  rawArticleId         String     @unique
  rawArticle           RawArticle @relation(fields: [rawArticleId], references: [id], onDelete: Cascade)
  categories           Category[] @relation("ProcessedArticleCategories")
  entities             String[]
  sentimentScore       Float?
  biasNote             String?
  biasCategory         String? // "Western", "Eastern", "Non-Western", "Neutral"
  perspectiveCountries String[]
  model                String?
  processedAt          DateTime   @default(now())

  matchedTopics UserTopic[]
  storyClusters StoryCluster[] @relation("ArticleStoryClusters")
}

model AiUsage {
  id            String   @id @default(uuid())
  date          String // Format: YYYY-MM-DD for easy querying
  provider      String
  model         String
  tokensUsed    Int
  estimatedCost Float
  success       Boolean
  createdAt     DateTime @default(now())

  @@index([date])
}

model ChatSession {
  id           String   @id @default(uuid())
  userId       String?
  title        String   @default("New Chat")
  model        String   @default("groq/compound-mini")
  responseMode String   @default("descriptive")
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages ChatMessage[]
  contexts ChatContext[]
  toolRuns ChatToolRun[]

  @@index([userId, updatedAt])
  @@index([isArchived, updatedAt])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  text      String      @db.Text
  parts     Json
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model ChatContext {
  id         String      @id @default(uuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceType String
  sourceId   String?
  title      String
  url        String?
  snapshot   Json?
  createdAt  DateTime    @default(now())

  @@unique([sessionId, sourceType, sourceId])
  @@index([sessionId])
}

model ChatToolRun {
  id         String       @id @default(uuid())
  sessionId  String?
  session    ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  messageId  String?
  toolName   String
  input      Json?
  output     Json?
  status     String
  durationMs Int?
  createdAt  DateTime     @default(now())

  @@index([sessionId, createdAt])
  @@index([toolName, createdAt])
}

model StoryCluster {
  id              String  @id @default(uuid())
  slug            String  @unique
  title           String
  summary         String  @db.Text
  timeWindow      String?
  keyDevelopments Json?
  isActive        Boolean @default(true)

  // Intelligence
  impact       String?
  impactScore  Float?
  status       String?
  whyItMatters String? @db.Text

  regions String[]
  themes  String[]

  // Signals
  articleCount Int      @default(0)
  sourceCount  Int?
  topSources   String[]

  lastActivityAt DateTime?
  activityScore  Float?

  trendData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles ProcessedArticle[] @relation("ArticleStoryClusters")
}

model LockedTopic {
  id                  String     @id @default(uuid())
  userId              String? // nullable — single user for now, ready for multi-user
  displayName         String
  userContext         String     @db.Text
  aiRefinedQuery      String     @db.Text
  aiQuerySummary      String     @db.Text
  conceptualKeywords  Json? // Array of keyword groups for broad pre-filtering
  liveWebSummary      String?    @db.Text
  liveSummary         String?    @db.Text // AI-generated findings overview (distinct from liveWebSummary)
  sources             Json // SourceConfig[]
  searchBeyondSources Boolean    @default(true)
  isActive            Boolean    @default(true)
  notifyEnabled       Boolean    @default(false)
  notifyMode          NotifyMode @default(DIGEST)
  notifyThreshold     Float      @default(0.8)
  notifyChannels      Json // { discord: bool, telegram: bool }
  matchCount          Int        @default(0)
  lastMatchedAt       DateTime?
  lastViewedAt        DateTime?
  lastScannedAt       DateTime? // null = initial scan not yet run (scanning state)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  findings TopicFinding[]
}

model TopicFinding {
  id             String        @id @default(uuid())
  topicId        String
  topic          LockedTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title          String
  summary        String?
  sourceType     FindingSource
  sourceUrl      String
  sourceName     String
  rawArticleId   String? // nullable — links to ProcessedArticle if internal
  relevanceScore Float?
  isRead         Boolean       @default(false)
  foundAt        DateTime      @default(now())
  metadata       Json? // { location, salary, company, etc. }

  @@unique([topicId, sourceUrl]) // deduplication constraint
  @@index([topicId, foundAt])
  @@index([topicId, relevanceScore])
}

enum NotifyMode {
  DIGEST
  ALERT
}

enum FindingSource {
  ARTICLE // from internal ProcessedArticle DB
  GOOGLE // Google News RSS
  BRAVE // Brave Search API
  REDDIT // Reddit search
  RSS // user-added RSS feed
  SCRAPE // pre-built Tier 2 scraper
  WEBPAGE // user-added webpage diff
  GITHUB // GitHub releases/tags
  BD_GOV_JOBS // Bangladesh Government Job Circulars
  COMPANY_CAREERS // Brute-force ATS checks (Greenhouse, Lever)
  SEARCH // DuckDuckGo/Brave internet search results
}
