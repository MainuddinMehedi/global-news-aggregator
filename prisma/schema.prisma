generator client {
  provider = "prisma-client-js"
  output   = "../shared/prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model Category {
  id       String             @id @default(uuid())
  name     String             @unique
  articles ProcessedArticle[] @relation("ProcessedArticleCategories")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      UserRole @default(USER)
  suspended Boolean  @default(false)
  settings  Json?

  accounts               Account[]
  sessions               Session[]
  articleBookmarks       ArticleBookmark[]
  findingBookmarks       FindingBookmark[]
  notifications          Notification[]
  notificationPreference NotificationPreference?

  lockedTopics LockedTopic[]
  chatSessions ChatSession[]
}

model RawArticle {
  id               String   @id @default(uuid())
  title            String
  contentSnippet   String   @db.Text
  extractedContent String?  @db.Text
  url              String   @unique
  slug             String?  @unique
  source           String
  sourceCountry    String?
  sourceType       String?
  biasGroup        String?
  coverageScope    String?
  publishedAt      DateTime
  fetchedAt        DateTime @default(now())
  contentHash      String?  @unique
  rawMetadata      Json?

  processedArticle ProcessedArticle?

  @@index([publishedAt])
  @@index([sourceCountry])
}

model ProcessedArticle {
  id             String                      @id @default(uuid())
  rawArticleId   String                      @unique
  rawArticle     RawArticle                  @relation(fields: [rawArticleId], references: [id], onDelete: Cascade)
  categories     Category[]                  @relation("ProcessedArticleCategories")
  entities       String[]
  sentimentScore Float?
  biasNote       String?
  eventRegion    String?
  model          String?
  processedAt    DateTime                    @default(now())
  clusteredAt    DateTime?
  clusterStatus  String                      @default("HOLDING")
  embedding      Unsupported("vector(768)")?
  storyClusters  StoryCluster[]              @relation("ArticleStoryClusters")
  bookmarkedBy   ArticleBookmark[]
}

model AiUsage {
  id            String   @id @default(uuid())
  date          String // Format: YYYY-MM-DD for easy querying
  provider      String
  model         String
  tokensUsed    Int
  estimatedCost Float
  success       Boolean
  createdAt     DateTime @default(now())

  @@index([date])
  @@index([createdAt])
}

model ChatSession {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String   @default("New Chat")
  model        String   @default("groq/compound-mini")
  responseMode String   @default("descriptive")
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages ChatMessage[]
  contexts ChatContext[]
  toolRuns ChatToolRun[]

  @@index([userId, updatedAt])
  @@index([isArchived, updatedAt])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  text      String      @db.Text
  parts     Json
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model ChatContext {
  id         String      @id @default(uuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceType String
  sourceId   String?
  title      String
  url        String?
  snapshot   Json?
  createdAt  DateTime    @default(now())

  @@unique([sessionId, sourceType, sourceId])
  @@index([sessionId])
}

model ChatToolRun {
  id         String       @id @default(uuid())
  sessionId  String?
  session    ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  messageId  String?
  toolName   String
  input      Json?
  output     Json?
  status     String
  durationMs Int?
  createdAt  DateTime     @default(now())

  @@index([sessionId, createdAt])
  @@index([toolName, createdAt])
}

model StoryCluster {
  id              String  @id @default(uuid())
  slug            String  @unique
  title           String
  summary         String  @db.Text
  timeWindow      String?
  keyDevelopments Json?
  isActive        Boolean @default(true)

  // Intelligence
  impact        String?
  impactScore   Float?
  status        String? @default("DEVELOPING")
  momentumScore Float   @default(0)
  whyItMatters  String? @db.Text

  regions String[]
  themes  String[]

  // Signals
  articleCount Int      @default(0)
  sourceCount  Int?
  topSources   String[]

  lastActivityAt DateTime?
  activityScore  Float?

  trendData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles ProcessedArticle[] @relation("ArticleStoryClusters")
}

model LockedTopic {
  id                 String                      @id @default(uuid())
  userId             String
  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String
  userContext        String                      @db.Text
  aiRefinedQuery     String                      @db.Text
  aiQuerySummary     String                      @db.Text
  queryEmbedding     Unsupported("vector(768)")? // [NEW] Semantic representation of the topic
  conceptualKeywords Json? // Array of keyword groups for broad pre-filtering
  liveWebSummary     String?                     @db.Text
  liveSummary        String?                     @db.Text // AI-generated findings overview (distinct from liveWebSummary)
  sources            Json // SourceConfig[]
  isActive           Boolean                     @default(true)
  notifyEnabled      Boolean                     @default(false)
  notifyMode         NotifyMode                  @default(DIGEST)
  notifyThreshold    Float                       @default(0.8)
  notifyChannels     Json // { discord: bool, telegram: bool }
  matchCount         Int                         @default(0)
  lastMatchedAt      DateTime?
  lastViewedAt       DateTime?
  lastScannedAt      DateTime? // null = initial scan not yet run (scanning state)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  findings TopicFinding[]
}

model TopicFinding {
  id             String        @id @default(uuid())
  topicId        String
  topic          LockedTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title          String
  summary        String?
  sourceType     FindingSource
  sourceUrl      String
  sourceName     String
  rawArticleId   String? // nullable — links to ProcessedArticle if internal
  relevanceScore Float?
  isRead         Boolean       @default(false)
  foundAt        DateTime      @default(now())
  metadata       Json? // { location, salary, company, etc. }

  bookmarkedBy FindingBookmark[]

  @@unique([topicId, sourceUrl]) // deduplication constraint
  @@index([topicId, foundAt])
  @@index([topicId, relevanceScore])
}

enum NotifyMode {
  DIGEST
  ALERT
}

enum FindingSource {
  ARTICLE // from internal ProcessedArticle DB
  GOOGLE // Google News RSS
  REDDIT // Reddit search
  RSS // user-added RSS feed
  SCRAPE // pre-built Tier 2 scraper
  WEBPAGE // user-added webpage diff
  GITHUB // GitHub releases/tags
  BD_GOV_JOBS // Bangladesh Government Job Circulars
  COMPANY_CAREERS // Brute-force ATS checks (Greenhouse, Lever, etc)
  SEARCH // DuckDuckGo/Brave internet search results
  YOUTUBE // YouTube channels and search discovery
}

// --- NextAuth Models ---

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Bookmarking Models ---

model ArticleBookmark {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   ProcessedArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([userId, articleId])
  @@index([userId])
}

model FindingBookmark {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  findingId String
  finding   TopicFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, findingId])
  @@index([userId])
}

model FeedSource {
  id            String    @id @default(uuid())
  name          String    @unique
  url           String    @unique
  sourceCountry String
  sourceType    String // e.g. "Commercial Publisher", "State Media"
  biasGroup     String // e.g. "Centrist", "State-Aligned"
  coverageScope String // e.g. "National", "Global"
  enabled       Boolean   @default(true)
  fetchFailures Int       @default(0)
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SystemSetting {
  key         String   @id
  value       Json // Arbitrary configuration object
  description String?
  updatedAt   DateTime @updatedAt
}

model SystemTask {
  id           String    @id @default(uuid())
  taskName     String // e.g., "rss-ingestion", "story-clustering", "locked-topic-scan", "backlog-processing"
  status       String // "RUNNING" | "SUCCESS" | "FAILED"
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  heartbeatAt  DateTime  @default(now())
  errorMessage String?   @db.Text
  metadata     Json? // Statistics: { fetchedCount: Int, insertedCount: Int, dupeCount: Int, cost: Float }

  @@index([taskName, status])
  @@index([startedAt])
}

enum NotificationType {
  // User-facing (defined now, wired later)
  TOPIC_FINDING_ALERT
  TOPIC_FINDING_DIGEST
  SYSTEM_NEWS_DIGEST
  TOPIC_SCAN_DEGRADED
  STORY_BREAKING
  STORY_ESCALATING
  NEW_SOURCE_ADDED

  // Admin-facing (wired in this phase)
  PIPELINE_FAILURE
  INGESTION_STALLED
  HIGH_FAILURE_RATE
  AI_PROVIDER_DEGRADED
  REVALIDATION_FAILED
  TOPIC_SOURCE_DEGRADED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationChannel {
  IN_APP
  DISCORD
  TELEGRAM
  EMAIL
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String               @db.Text
  priority  NotificationPriority @default(NORMAL)
  payload   Json?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model NotificationDelivery {
  id             String              @id @default(uuid())
  notificationId String
  channel        NotificationChannel
  deliveredAt    DateTime?
  error          String?             @db.Text
  retryCount     Int                 @default(0)
  createdAt      DateTime            @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([deliveredAt])
}

model NotificationPreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  inAppEnabled    Boolean @default(true)
  discordEnabled  Boolean @default(false)
  telegramEnabled Boolean @default(false)
  discordWebhook  String?
  telegramChatId  String?

  typePreferences Json @default("{}")

  digestEnabled   Boolean @default(false)
  digestFrequency String  @default("12h")
  digestTime      String? @default("08:00")
  digestTimezone  String  @default("UTC")

  quietHoursEnabled Boolean @default(false)
  quietHoursStart   String?
  quietHoursEnd     String?
  quietTimezone     String  @default("UTC")

  lastDigestAt DateTime?
  updatedAt    DateTime  @updatedAt
}

model AdminNotificationConfig {
  id              String           @id @default(uuid())
  type            NotificationType @unique
  inAppEnabled    Boolean          @default(true)
  discordEnabled  Boolean          @default(false)
  telegramEnabled Boolean          @default(false)
  discordWebhook  String?
  telegramChatId  String?
  cooldownMinutes Int              @default(60)
  updatedAt       DateTime         @updatedAt
}
